# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ---------- Bizora: local data (never commit) ----------
data/
business-files/
*.db
*.db-wal
*.db-shm
*.sqlite

# ---------- Desktop build output (generated) ----------
electron-dist/
release/
# NOTE: build/icon.png IS committed. The installer needs it.

# ---------- Environment variables ----------
.env*
!.env.example

# ---------- Dependencies ----------
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---------- Testing ----------
/coverage

# ---------- Next.js ----------
/.next/
/out/

# ---------- Misc ----------
.DS_Store
*.pem
.vercel
*.tsbuildinfo
next-env.d.ts

# ---------- Logs ----------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*