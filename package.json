    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.11",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
