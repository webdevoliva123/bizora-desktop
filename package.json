{
  "name": "bizora",
  "version": "0.1.0",
  "private": true,
  "main": "electron-dist/main.js",
  "scripts": {
    "dev": "next dev",
    "dev:electron": "concurrently -k \"next dev\" \"tsc -p electron/tsconfig.json --watch\" \"wait-on http://localhost:3000 file:electron-dist/main.js && electron electron-dist/main.js\"",
    "build": "next build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "build:desktop": "next build && npm run build:electron && node scripts/prepare-electron.mjs",
    "dist:mac": "npm run build:desktop && electron-builder --mac",
    "dist:win": "npm run build:desktop && electron-builder --win",
    "dist:linux": "npm run build:desktop && electron-builder --linux",
    "clean:data": "node -e \"const fs=require('fs');for(const f of ['data/bizora.db','data/bizora.db-wal','data/bizora.db-shm'])fs.rmSync(f,{force:true});fs.rmSync('business-files',{recursive:true,force:true});console.log('Local data deleted.')\""
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.3",
    "html2canvas-pro": "^2.5.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.50.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.2.8",
    "react-to-print": "^3.3.0",
    "recharts": "^3.8.0",
    "shadcn": "^4.21.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.11",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.5.1",
    "@electron/rebuild": "^4.0.1"
  },
  "description": "Bizora - business management and billing desktop app",
  "author": {
    "name": "Bizora",
    "email": "support@bizora.app"
  },
  "homepage": "https://bizora.app",
  "build": {
    "appId": "com.bizora.app",
    "productName": "Bizora",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron-dist/**/*",
      "package.json",
      "!node_modules/**"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "app"
      },
      {
        "from": "drizzle",
        "to": "drizzle"
      }
    ],
    "mac": {
      "category": "public.app-category.business",
      "target": [
        "dmg"
      ],
      "artifactName": "Bizora-mac-arm64.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Bizora-windows-x64.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "maintainer": "Bizora <support@bizora.app>",
      "artifactName": "Bizora-linux-x64.${ext}"
    },
    "afterPack": "scripts/after-pack.cjs",
    "npmRebuild": false
  }
}